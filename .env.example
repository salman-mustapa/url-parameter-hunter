# Database Configuration (PostgreSQL for Docker, SQLite for local standalone)
DATABASE_URL=postgresql+asyncpg://bughunter:bughunter@postgres:5432/bughunter
# For local SQLite development:
# DATABASE_URL=sqlite+aiosqlite:///storage/bughunter.db

# API & Security
CORS_ORIGINS=*
SECURITY_MODE=SAFE

# Scanner Concurrency & Limits
RATE_LIMIT_RPS=15
MAX_CONCURRENT_HOSTS=12
MAX_ASSETS_PER_SCAN=2500
MAX_URLS_PER_SCAN=20000
MAX_RUNTIME_MINUTES=45
PORT_TIMEOUT_SECONDS=1.5
HTTP_TIMEOUT_SECONDS=8.0

