# Authentication: generate with python -c "import secrets; print(secrets.token_urlsafe(48))"
# A unique JWT_SECRET of at least 32 characters is recommended in production (auto-generates ephemeral key if blank).
APP_ENV=development
JWT_SECRET=
COOKIE_SECURE=false
SEED_DEFAULT_USERS=false
# Optional first administrator (only for initial bootstrap; remove password afterwards).
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ==============================================================================
# Database Configuration
# ==============================================================================
# For Docker (PostgreSQL):
DATABASE_URL=postgresql+asyncpg://bughunter:bughunter@postgres:5432/bughunter

# For Local Standalone Development (SQLite default):
# DATABASE_URL=sqlite+aiosqlite:///storage/bughunter.db

# ==============================================================================
# Server & Scanner Limits
# ==============================================================================
# Empty means same-origin UI. Use explicit comma-separated origins for other clients.
CORS_ORIGINS=
SECURITY_MODE=SAFE
RATE_LIMIT_RPS=15
MAX_CONCURRENT_HOSTS=12
MAX_ASSETS_PER_SCAN=2500
MAX_URLS_PER_SCAN=20000
MAX_RUNTIME_MINUTES=45
PORT_TIMEOUT_SECONDS=1.5
HTTP_TIMEOUT_SECONDS=8.0
MAX_HTTP_CONNECTIONS=64
MAX_HTTP_KEEPALIVE_CONNECTIONS=16
MAX_CONCURRENT_PORT_PROBES=32
MAX_CONCURRENT_SERVICE_VALIDATIONS=2
CREDENTIAL_AUDIT_ENABLED=true
CREDENTIAL_AUDIT_MAX_ATTEMPTS=10
CREDENTIAL_AUDIT_DELAY_SECONDS=0.75
NMAP_VULN_ENABLED=true
NMAP_VULN_TIMEOUT_SECONDS=120
NMAP_VULN_MAX_PORTS=12
NMAP_VULN_SCRIPT_TIMEOUT_SECONDS=30
SSE_REPLAY_LIMIT=500
SSE_CLIENT_QUEUE_SIZE=256
SSE_KEEPALIVE_SECONDS=10
AUTO_RESUME_SCANS_ON_STARTUP=false
MAX_AUTO_RESUME_SCANS=2

# ==============================================================================
# AI / LLM Pentest Orchestrator Configuration
# ==============================================================================
LLM_ENABLED=false

# ------------------------------------------------------------------------------
# OPTION 1: NineRouter / your OpenAI-compatible NineRouter deployment
# ------------------------------------------------------------------------------
LLM_PROVIDER=ninerouter
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=combo

# ------------------------------------------------------------------------------
# OPTION 2: OpenRouter (availability, quotas, and model IDs can change)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# Use :free or openrouter/free only after checking the provider's live model list.
# LLM_MODEL=openrouter/free

# ------------------------------------------------------------------------------
# OPTION 3: Google Gemini API (quota depends on the current account/tier)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here
# LLM_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# OPTION 4: Groq Cloud (quota depends on the current account/tier)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# OPTION 5: Ollama (Local Offline - 100% Free, No Internet Required)
# Run locally: ollama run hermes3
# ------------------------------------------------------------------------------
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=hermes3

# LLM Generation Parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=25
LLM_ROUTING_MODE=auto
# auto: legacy LLM_MODEL=combo means application task routing.
# single: send exactly LLM_MODEL; no application model/Hermes fallback.
# router_combo: send the exact saved NineRouter combo name, e.g. security.
# task_router: application task aliases/cascade, then optional Hermes fallback.
# UI Save & Apply changes this server process only, not this file.

# Optional Hermes Agent/model fallback. It must expose an OpenAI-compatible API.
# Hermes API Server profile must have all toolsets disabled (analysis only).
# HERMES_BASE_URL=http://127.0.0.1:8642/v1
# HERMES_API_KEY=
# HERMES_MODEL=hermes-agent

# Runner API: batas per proses (bukan koordinasi multi-worker)
MAX_CONCURRENT_SCANS=2
MAX_PENDING_SCANS=20
MAX_BROWSER_CAPTURES=1
# Aktifkan hanya setelah Chromium sandbox dan egress worker diverifikasi.
BROWSER_CAPTURE_ENABLED=false
